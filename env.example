# ==============================================================
# Rename file ini ke .env dan isi dengan value asli.
# JANGAN commit file .env (isi asli) ke git - tambahkan ke .gitignore.
# ==============================================================

# --- WPScan (wpscan_runner.py) ---
# Token dari https://wpscan.com/api untuk akses vulnerability database.
WPSCAN_API_TOKEN=your_wpscan_api_token_here

# --- Vuln analysis provider switch ---
# Pilih "anthropic" atau "gemini". tasks.py membaca ini untuk menentukan
# modul analyzer mana yang dipakai.
VULN_ANALYZER_PROVIDER=anthropic

# --- Anthropic / Claude API (vuln_analyzer.py) ---
# Dipakai untuk analisis CVE, severity, dan rekomendasi remediasi.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT=60

# --- Google Gemini API (vuln_analyzer_gemini.py) ---
# Alternatif dari Anthropic - dipakai kalau VULN_ANALYZER_PROVIDER=gemini.
# Cek model terbaru di https://ai.google.dev/gemini-api/docs/models
# (Google cukup sering retire model lama, mis. Gemini 2.0 sudah dipensiunkan pertengahan 2026).
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=60

# --- Celery / Redis (tasks.py) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False


# --- Database (models.py / app.py) ---
DATABASE_URL=postgresql://user:password@localhost:5432/wpscan_db

# --- Flask app (app.py) ---
FLASK_SECRET_KEY=change_this_to_a_random_secret_value
FLASK_ENV=production
