# ==============================================================
# Rename file ini ke .env dan isi dengan value asli.
# JANGAN commit file .env (isi asli) ke git.
# ==============================================================

# --- Flask app (config.py / app.py) ---
FLASK_SECRET_KEY=change_this_to_a_random_secret_value
FLASK_ENV=development
FLASK_DEBUG=0
WTF_CSRF_ENABLED=True
RATELIMIT_ENABLED=True

# --- Initial Admin Seed (dipakai hanya jika tabel admin kosong) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- Database (SQLite default, atau MySQL / PostgreSQL) ---
# SQLite:
# DATABASE_URL=sqlite:///wpsecops.db
# MySQL (PyMySQL):
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/wpsecops
# PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/wpscan_db

# --- Celery / Redis (extensions.py / tasks.py) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Nuclei Templates ---
NUCLEI_TEMPLATES_DIR=

# --- Google Gemini API (services/vuln_analyzer.py) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=180

# --- Anthropic / Claude API (services/vuln_analyzer.py) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_TIMEOUT=60

# --- WPScan (opsional, No-API mode tetap aktif secara default) ---
WPSCAN_API_TOKEN=
